<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>coquena</AssemblyName>
    <Version>0.5.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Coquena.Tests" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <EmbeddedResource Include="Localization/*.json" LogicalName="languages/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Terminal.Gui pulls libonigwrap (TextMate regexes) transitively; Coquena does not use it. -->
  <Target Name="ExcludeOnigwrap" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Filename)' == 'libonigwrap'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Filename)' == 'libonigwrap'" />
    </ItemGroup>
  </Target>
</Project>
